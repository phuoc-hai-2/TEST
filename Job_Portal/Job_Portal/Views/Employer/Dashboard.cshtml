@model IEnumerable<Job_Portal.Models.JobPosting>
@{
    ViewData["Title"] = "Quản lý tin tuyển dụng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="main-content-section">
    <h2 class="mb-4" style="font-weight:700;">Tin tuyển dụng của bạn</h2>
    <a asp-action="Create" class="btn btn-primary mb-3">+ Đăng tin mới</a>
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Tiêu đề</th>
                        <th>Vị trí</th>
                        <th>Địa điểm</th>
                        <th>Mức lương</th>
                        <th>Ngày đăng</th>
                        <th>Hạn nộp</th>
                        <th>Ứng viên</th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model)
                    {
                        <tr>
                            <td>@job.Title</td>
                            <td>@job.Position</td>
                            <td>@job.Workplace</td>
                            <td>@job.Salary</td>
                            <td>@job.PostedDate.ToString("dd/MM/yyyy")</td>
                            <td>@job.ApplicationDeadline.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a asp-action="Applications" asp-route-id="@job.Id" class="btn btn-outline-info btn-sm">
                                    Xem ứng viên
                                </a>
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-warning btn-sm">Chỉnh sửa</a>
                            </td>
                            <td>
                                <form asp-action="Delete" asp-route-id="@job.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa tin này?');" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">Bạn chưa có tin tuyển dụng nào.</div>
    }
</div>