@model List<Job_Portal.Models.JobPosting>
@{
    ViewData["Title"] = "Dashboard - Quản lý tuyển dụng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <h2 class="mb-4">Dashboard Nhà tuyển dụng</h2>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="fas fa-plus"></i> Đăng tin mới
    </a>
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Tiêu đề công việc</th>
                        <th>Danh mục</th>
                        <th>Công ty</th>
                        <th>Địa điểm</th>
                        <th>Ngày đăng</th>
                        <th>Ứng viên</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.OrderByDescending(j => j.PostedDate))
                    {
                        <tr>
                            <td>@job.Title</td>
                            <td>@job.Category?.Name</td>
                            <td>@job.Company?.Name</td>
                            <td>@job.Location</td>
                            <td>@job.PostedDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a asp-action="Applications" asp-route-id="@job.Id" class="btn btn-sm btn-outline-success">
                                    @job.Applications?.Count() ?? 0 ứng viên
                                </a>
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Details" asp-controller="Jobs" asp-route-id="@job.Id" class="btn btn-sm btn-info">Chi tiết</a>
                                    <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-sm btn-warning">Sửa</a>
                                    <!-- Xóa có thể làm thêm modal xác nhận nếu muốn -->
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Bạn chưa có tin tuyển dụng nào. <a asp-action="Create">Đăng tin ngay!</a>
        </div>
    }
</div>