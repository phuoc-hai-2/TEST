@model Job_Portal.Models.JobPosting
@{
    ViewData["Title"] = "Chỉnh sửa tin tuyển dụng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="main-content-section">
    <h2 class="mb-4" style="font-weight:700;">@ViewData["Title"]</h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div>
                <div class="mb-3"><label asp-for="Position" class="form-label"></label><input asp-for="Position" class="form-control" /></div>
                <div class="mb-3"><label asp-for="Workplace" class="form-label"></label><input asp-for="Workplace" class="form-control" /></div>
                <div class="mb-3"><label asp-for="Salary" class="form-label"></label><input asp-for="Salary" class="form-control" /></div>
                <div class="mb-3"><label asp-for="ApplicationDeadline" class="form-label"></label><input asp-for="ApplicationDeadline" class="form-control" type="date" /></div>
                <div class="mb-3"><label asp-for="JobType" class="form-label"></label><input asp-for="JobType" class="form-control" /></div>
                <div class="mb-3"><label asp-for="DegreeRequirement" class="form-label"></label><input asp-for="DegreeRequirement" class="form-control" /></div>
            </div>
            <div class="col-md-6">
                <div class="mb-3"><label asp-for="ExperienceRequirement" class="form-label"></label><input asp-for="ExperienceRequirement" class="form-control" /></div>
                <div class="mb-3"><label asp-for="AgeRequirement" class="form-label"></label><input asp-for="AgeRequirement" class="form-control" /></div>
                <div class="mb-3"><label asp-for="Industry" class="form-label"></label><input asp-for="Industry" class="form-control" /></div>
                <div class="mb-3"><label asp-for="Specialty" class="form-label"></label><input asp-for="Specialty" class="form-control" /></div>
                <div class="mb-3"><label asp-for="PostedDate" class="form-label"></label><input asp-for="PostedDate" class="form-control" type="date" /></div>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="7"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Cập nhật</button>
        <a asp-action="Dashboard" class="btn btn-secondary">Quay lại</a>
    </form>
</div>