@model Job_Portal.Models.JobPosting
@{
    ViewData["Title"] = "Đăng tin tuyển dụng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="main-content-section">
    <h2 class="mb-4" style="font-weight:700;">@ViewData["Title"]</h2>
    <form asp-action="Create" method="post" autocomplete="off">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>        
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Position" class="form-label"></label>
                    <input asp-for="Position" class="form-control" placeholder="Nhân Viên/Chuyên Viên" />
                    <span asp-validation-for="Position" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Workplace" class="form-label"></label>
                    <input asp-for="Workplace" class="form-control" placeholder="Toàn quốc, Hồ Chí Minh, ..." />
                    <span asp-validation-for="Workplace" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="CompanyId" class="form-label">Công ty</label>
                    <select asp-for="CompanyId" class="form-control" asp-items="ViewBag.CompanyList"></select>
                    <span asp-validation-for="CompanyId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Salary" class="form-label"></label>
                    <input asp-for="Salary" class="form-control" type="number" min="0" step="0.01" placeholder="15000000" />
                    <span asp-validation-for="Salary" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ApplicationDeadline" class="form-label"></label>
                    <input asp-for="ApplicationDeadline" class="form-control" type="date" />
                    <span asp-validation-for="ApplicationDeadline" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="JobType" class="form-label"></label>
                    <input asp-for="JobType" class="form-control" placeholder="Toàn thời gian" />
                    <span asp-validation-for="JobType" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="DegreeRequirement" class="form-label"></label>
                    <input asp-for="DegreeRequirement" class="form-control" placeholder="Cao Đẳng" />
                    <span asp-validation-for="DegreeRequirement" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="Category_Name" class="form-label">Phân loại công việc (Category)</label>
                    <input type="text" name="Category.Name" id="Category_Name" class="form-control" placeholder="VD: IT, Kế toán, Giáo dục..." />
                    <span asp-validation-for="Category.Name" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="ExperienceRequirement" class="form-label"></label>
                    <input asp-for="ExperienceRequirement" class="form-control" placeholder="Trên 0.5 năm" />
                    <span asp-validation-for="ExperienceRequirement" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="AgeRequirement" class="form-label"></label>
                    <input asp-for="AgeRequirement" class="form-control" placeholder="20-40" />
                    <span asp-validation-for="AgeRequirement" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Industry" class="form-label"></label>
                    <input asp-for="Industry" class="form-control" placeholder="Kinh Doanh/Bán Hàng, ..." />
                    <span asp-validation-for="Industry" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Specialty" class="form-label"></label>
                    <input asp-for="Specialty" class="form-control" placeholder="Tư Vấn B2B, Phát Triển Thị Trường" />
                    <span asp-validation-for="Specialty" class="text-danger"></span>
                </div>
                <input asp-for="PostedDate" type="hidden" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="7" placeholder="Mô tả công việc..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Đăng tin</button>
        <a asp-action="Dashboard" class="btn btn-secondary">Quay lại</a>
    </form>
</div>