@model List<Job_Portal.Models.JobPosting>
@{
    ViewData["Title"] = "Danh sách việc làm mới nhất";
}
<div class="main-content-section">
    <h2 class="mb-4" style="font-weight:700;">Danh sách việc làm mới nhất</h2>
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var job in Model)
        {
            var isExpired = job.ApplicationDeadline < DateTime.UtcNow;
            var isClosed = job.IsClosed;
            <div class="col">
                <div class="job-card">
                    <div class="job-title">@job.Title</div>
                    <div class="job-info">
                        <b>Mức lương:</b> <span style="color:#0061d4;">@job.Salary</span>
                        <span class="ms-3"><b>Địa điểm:</b> @job.Workplace</span>
                    </div>
                    <div class="job-info">
                        <b>Vị trí:</b> @job.Position
                        <span class="ms-3"><b>Loại hình:</b> @job.JobType</span>
                    </div>
                    <div class="job-info">
                        <b>Hạn nộp:</b> @job.ApplicationDeadline.ToString("dd/MM/yyyy")
                        <span class="ms-3">
                            <b>Trạng thái:</b>
                            @if (isClosed)
                            {
                                <span class="badge bg-danger">Đã đóng</span>
                            }
                            else if (isExpired)
                            {
                                <span class="badge bg-warning text-dark">Hết hạn</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Mở ứng tuyển</span>
                            }
                        </span>
                    </div>
                    <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-primary btn-sm mt-2">Xem chi tiết</a>
                </div>
            </div>
        }
    </div>
</div>