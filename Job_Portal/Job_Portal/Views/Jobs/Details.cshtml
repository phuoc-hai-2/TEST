@model Job_Portal.Models.JobPosting
@{
    ViewData["Title"] = "Chi tiết công việc";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <h2>@Model.Title</h2>
    <p>
        <strong>Danh mục:</strong> @Model.Category?.Name <br />
        <strong>Công ty:</strong> @Model.Company?.Name <br />
        <strong>Địa điểm:</strong> @Model.Location <br />
        <strong>Ngày đăng:</strong> @Model.PostedDate.ToString("dd/MM/yyyy") <br />
    </p>
    <hr />
    <div>
        <h5>Mô tả công việc</h5>
        <p>@Model.Description</p>
    </div>
    <hr />
    <form asp-controller="JobApplication" asp-action="Apply" method="post">
        <input type="hidden" name="jobId" value="@Model.Id" />
        <button type="submit" class="btn btn-success">Ứng tuyển ngay</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info mt-3">@TempData["Message"]</div>
    }
</div>