@using Microsoft.AspNetCore.Identity
@inject SignInManager<Job_Portal.Models.ApplicationUser> SignInManager
@inject UserManager<Job_Portal.Models.ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Job Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .search-bar {
            max-width: 600px;
            flex-grow: 1;
        }

        .navbar-dark {
            background-color: #003366;
        }

        .form-control:focus {
            box-shadow: none;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
        <div class="container-fluid d-flex align-items-center justify-content-between">
            <a class="navbar-brand fw-bold text-white" asp-controller="Jobs" asp-action="Index">
                Job Portal
            </a>


            <ul class="navbar-nav d-flex flex-row align-items-center">
                @* Phần Tất cả danh mục đã được chỉnh sửa thành dropdown *@
                <li class="nav-item dropdown me-2">
                    <a class="btn btn-outline-light dropdown-toggle" href="#" id="navbarCategoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        ☰ Tất cả danh mục
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="navbarCategoryDropdown">
                        @{
                            // Lấy danh sách Categories từ ViewBag
                            List<Job_Portal.Models.Category> categories = ViewBag.Categories as List<Job_Portal.Models.Category>;
                        }
                        @if (categories != null && categories.Any())
                        {
                            <li><h6 class="dropdown-header">Theo ngành nghề</h6></li>
                            <li><a class="dropdown-item" asp-controller="Jobs" asp-action="Index">Tất cả ngành nghề</a></li>
                            <li><hr class="dropdown-divider"></li>
                            @foreach (var category in categories)
                            {
                                <li><a class="dropdown-item" asp-controller="Jobs" asp-action="Index" asp-route-categoryId="@category.Id">@category.Name</a></li>
                            }
                        }
                        else
                        {
                            <li><a class="dropdown-item" href="#">Không có danh mục nào</a></li>
                        }
                    </ul>
                </li>
                @* Kết thúc phần Tất cả danh mục *@

                <li class="nav-item me-2">
                    <a class="btn btn-outline-light" asp-controller="Employer" asp-action="Dashboard">👔 Nhà tuyển dụng</a> @* Đã sửa asp-action thành Dashboard *@
                </li>
                @if (SignInManager.IsSignedIn(User))
                {
                    var user = await UserManager.GetUserAsync(User);
                    <li class="nav-item dropdown me-2">
                        <a class="btn btn-outline-light dropdown-toggle" href="#" data-bs-toggle="dropdown">👤 @user.FullName</a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">⚙ Quản lý tài khoản</a></li>
                            <li>
                                <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="dropdown-item">
                                    <button type="submit" class="btn btn-link p-0 text-start">🚪 Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item me-2">
                        <a class="btn btn-outline-light" href="#">🔔</a>
                    </li>
                }
                else
                {
                    <li class="nav-item me-2">
                        <a class="btn btn-outline-light" asp-area="Identity" asp-page="/Account/Login">🔐 Đăng nhập</a>
                    </li>
                    <li class="nav-item me-2">
                        <a class="btn btn-outline-light" asp-area="Identity" asp-page="/Account/Register">📝 Đăng ký</a>
                    </li>
                }
            </ul>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="text-center mt-5 mb-2 text-muted">
        <p>&copy; @DateTime.Now.Year - Job Portal</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>