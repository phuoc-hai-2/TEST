@page
@model IndexModel
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Quản lý tài khoản";
    var isEmployer = User.IsInRole("Employer");
    var isJobSeeker = User.IsInRole("JobSeeker");
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header text-center bg-primary text-white">
                <h2 class="mb-0">@ViewData["Title"]</h2>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(Model.StatusMessage))
                {
                    <div class="alert alert-success" role="alert">
                        @Model.StatusMessage
                    </div>
                }
                <form method="post" autocomplete="off">
                    <div class="mb-3 row">
                        <label class="col-sm-3 col-form-label">Tên đăng nhập</label>
                        <div class="col-sm-9">
                            <input class="form-control" value="@Model.Username" disabled />
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="Input.FullName" class="col-sm-3 col-form-label"></label>
                        <div class="col-sm-9">
                            <input asp-for="Input.FullName" class="form-control" />
                            <span asp-validation-for="Input.FullName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="Input.PhoneNumber" class="col-sm-3 col-form-label"></label>
                        <div class="col-sm-9">
                            <input asp-for="Input.PhoneNumber" class="form-control" />
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                    @if (isJobSeeker)
                    {
                        <div class="mb-3 row">
                            <label asp-for="Input.Skills" class="col-sm-3 col-form-label"></label>
                            <div class="col-sm-9">
                                <input asp-for="Input.Skills" class="form-control" />
                                <span asp-validation-for="Input.Skills" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <label asp-for="Input.Qualifications" class="col-sm-3 col-form-label"></label>
                            <div class="col-sm-9">
                                <textarea asp-for="Input.Qualifications" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Input.Qualifications" class="text-danger"></span>
                            </div>
                        </div>
                    }
                    @if (isEmployer)
                    {
                        <div class="mb-3 row">
                            <label asp-for="Input.CompanyName" class="col-sm-3 col-form-label"></label>
                            <div class="col-sm-9">
                                <input asp-for="Input.CompanyName" class="form-control" />
                                <span asp-validation-for="Input.CompanyName" class="text-danger"></span>
                            </div>
                        </div>
                    }
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}